# SlaydHub AI - Environment Configuration Example
# Copy this file to .env and adjust variables as needed.

# Telegram bot token (required for bot to start)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Google Gemini API Key (for AI Content Generation)
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: custom output directory for generated presentations
# SLAYDHUB_OUTPUT_DIR=./output

# Optional: additional custom template library search paths (separated by OS-specific path separator)
# Linux/macOS example:
# SLAYDHUB_TEMPLATE_DIRS=./templates:./downloads
# Windows example:
# SLAYDHUB_TEMPLATE_DIRS=C:\\MyTemplates;D:\\MySlides

# Optional: override the default internal SOFF session file path
# SOFF_SESSION_FILE=./.cache/soff_session.json

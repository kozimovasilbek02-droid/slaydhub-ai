# ==============================================================================
# SlaydHub Ultra v4.1 (Production Environment Configuration)
# Nusxa oling va nomini .env qilib sozlang:
# ==============================================================================

# ── 1. ASOSIY TELEGRAM & AI MODEL SOZLAMALARI (MAJBURIY) ──────────────────────
TELEGRAM_BOT_TOKEN=1234567890:ABCdefGhIJKlmNoPQRstuVWXyz
GEMINI_API_KEY=AIzaSyYourGeminiApiKeyHere

# ── 2. RENDER.COM & LINUX 512MB RAM HIMOYA SOZLAMALARI ────────────────────────
PORT=10000
MALLOC_ARENA_MAX=2
MALLOC_TRIM_THRESHOLD_=65536

# ── 3. SOFF.UZ INTEGRATSIYA & AVTOMATIK SOTUV (SELLER API) ────────────────────
SELLER_TOKEN=your_soff_seller_jwt_token_here
# Ixtiyoriy: Token muddati o'tganda avtomatik yangilash (Refresh/Login)
SOFF_REFRESH_TOKEN=your_soff_refresh_token_here
SOFF_PHONE=+998901234567
SOFF_PASSWORD=your_soff_password_here
# SOFF_REFRESH_URL=https://api.soff.uz/api/v1/auth/token/refresh/
# SOFF_LOGIN_URL=https://api.soff.uz/api/v1/auth/login/

# ── 4. CLICK TO'LOV SHLYUZI (MERCHANT API) ────────────────────────────────────
CLICK_SERVICE_ID=12345
CLICK_MERCHANT_ID=12345
CLICK_SECRET_KEY=your_click_secret_key_here

# ── 5. PAYME TO'LOV SHLYUZI (JSON-RPC 2.0 MERCHANT API) ───────────────────────
PAYME_MERCHANT_ID=your_payme_merchant_id_24_chars
PAYME_MERCHANT_KEY=your_payme_merchant_key_here

# ── 6. IXTIYORIY QO'SHIMCHA SOZLAMALAR ────────────────────────────────────────
# 20MB dan katta fayllarni yuklash uchun mahalliy Bot API Server (ixtiyoriy)
# LOCAL_BOT_API_URL=http://localhost:8081

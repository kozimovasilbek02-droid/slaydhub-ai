# SlaydHub AI - Environment Configuration Example
# Copy this file to .env and adjust variables as needed.

# Google Gemini API Key (for AI Content Generation)
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Custom output directory for generated presentations
# SLAYDHUB_OUTPUT_DIR=C:\Users\user\Desktop\Antigravity\Power Point\output

# Optional: Additional custom template library search paths (separated by semicolon)
# SLAYDHUB_TEMPLATE_DIRS=C:\CustomTemplates;D:\MySlides
